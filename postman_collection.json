{
  "info": {
    "_postman_id": "c1f78239-84e5-47e9-a31a-e3251a3d90f2",
    "name": "Intro to Backend Tutorial API",
    "description": "Postman collection for testing the Intro to Backend Web Development Tutorial APIs (Users & Posts CRUD)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "post_id",
      "value": "replace-with-actual-post-id",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ronak\",\n  \"email\": \"ronak@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ronak@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "login"]
            }
          }
        },
        {
          "name": "Logout User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ronak@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create Post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My First Post\",\n  \"description\": \"Learning backend development with Node.js and Express\",\n  \"age\": 22\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/posts/create",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "posts", "create"]
            }
          }
        },
        {
          "name": "Get All Posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/posts/getPosts",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "posts", "getPosts"]
            }
          }
        },
        {
          "name": "Update Post",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Post Title\",\n  \"description\": \"Updated description text\",\n  \"age\": 23\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/posts/update/{{post_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "posts", "update", "{{post_id}}"]
            }
          }
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/posts/delete/{{post_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "posts", "delete", "{{post_id}}"]
            }
          }
        }
      ]
